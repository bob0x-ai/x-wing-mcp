# X OAuth 2.0 credentials (replace with your own values)
X_OAUTH2_CLIENT_ID=your_client_id_here
X_OAUTH2_CLIENT_SECRET=your_client_secret_here
X_OAUTH2_ACCESS_TOKEN=your_access_token_here
X_OAUTH2_REFRESH_TOKEN=your_refresh_token_here
X_OAUTH2_SCOPES="offline.access dm.read tweet.write like.write users.read dm.write tweet.read follows.write"

# Legacy aliases (optional, accepted as fallbacks)
X_CLIENT_ID=your_client_id_here
X_CLIENT_SECRET=your_client_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_REFRESH_TOKEN=your_refresh_token_here
X_SCOPES="offline.access dm.read tweet.write like.write users.read dm.write tweet.read follows.write"
